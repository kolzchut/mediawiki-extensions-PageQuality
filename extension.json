{
	"name": "PageQuality",
	"author": [
		"Nischayn22, WikiWorks",
		"Dror S. [FFS] ([https://www.kolzchut.org.il Kol-Zchut])"
	],
	"url": "https://www.mediawiki.org/wiki/Extension:PageQuality",
	"description": "Monitor and improve page quality",
	"version": "1.0.2",
	"license-name": "GPL-2.0-or-later",
	"type": "Special Page",
	"AutoloadNamespaces": {
		"MediaWiki\\Extension\\PageQuality\\": "includes/",
		"MediaWiki\\Extension\\PageQuality\\Scorer\\": "scorers/"
	},
	"AutoloadClasses": {
		"MediaWiki\\Extension\\PageQuality\\Maintenance\\PostDatabaseUpdate\\MigrateTimestampToMWFormat": "maintenance/PostDatabaseUpdate/migrateTimestampToMWFormat.php",
		"MediaWiki\\Extension\\PageQuality\\Maintenance\\PostDatabaseUpdate\\fixScoreLogAfterAddingStatus": "maintenance/PostDatabaseUpdate/fixScoreLogAfterAddingStatus.php"
	},
	"config": {
		"PageQualityNamespaces": {
			"value": [
				0
			],
			"merge_strategy": "provide_default"
		}
	},
	"AvailableRights": [
		"viewpagequality",
		"configpagequality"
	],
	"GroupPermissions": {
		"*": {
			"viewpagequality": true
		},
		"pagequality-admin": {
			"configpagequality": true
		}
	},
	"APIModules": {
		"page_quality_api": {
			"class": "MediaWiki\\Extension\\PageQuality\\Api",
			"services": [ "TitleFactory" ]
		}
	},
	"SpecialPages": {
		"PageQuality": {
			"class": "MediaWiki\\Extension\\PageQuality\\SpecialPageQuality",
			"services": [ "TitleFactory" ]
		}
	},
	"JobClasses": {
		"updatePageQuality": "MediaWiki\\Extension\\PageQuality\\RefreshJob"
	},
	"HookHandlers": {
		"main": {
			"class": "MediaWiki\\Extension\\PageQuality\\Hooks",
			"services": [ "PermissionManager" ]
		}
	},
	"Hooks": {
		"LoadExtensionSchemaUpdates": "main",
		"BeforePageDisplay": "main",
		"PageSaveComplete": "main"
	},
	"MessagesDirs": {
		"PageQuality": [
			"i18n"
		]
	},
	"ExtensionMessagesFiles": {
		"PageQualityAlias": "PageQuality.i18n.alias.php"
	},
	"ResourceModules": {
		"ext.page_quality": {
			"scripts": [
				"resources/page_quality.js"
			],
			"styles": [
				"resources/page_quality.less"
			],
			"dependencies": [
				"jquery.tablesorter"
			]
		},
		"ext.page_quality.special": {
			"scripts": [
				"resources/page_quality_special.js"
			],
			"dependencies": [
				"jquery.tablesorter",
				"oojs-ui-widgets"
			]
		}
	},
	"ResourceFileModulePaths": {
		"localBasePath": "",
		"remoteExtPath": "PageQuality"
	},
	"manifest_version": 2
}
